---
import { siteConfig, siteUrl } from '../site.config';

interface Props {
  rights: string;
}

const { rights } = Astro.props;
---

<footer class="site-footer">
  <div class="wrap footer-row">
    <p>{rights}</p>
    <a href={siteUrl}>{siteConfig.domain}</a>
    <a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>
  </div>
</footer>
