---
import LangSwitch from './LangSwitch.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';

interface NavLabels {
  about: string;
  founder: string;
  services: string;
  portfolio: string;
  process: string;
  contact: string;
}

interface Props {
  locale: 'ko' | 'en';
  labels: NavLabels;
  navLabel: string;
  langLabel: string;
}

const { locale, labels, navLabel, langLabel } = Astro.props;
const home = getRelativeLocaleUrl(locale);
const atHome = Astro.url.pathname.replace(/\/$/, '') === home.replace(/\/$/, '');
const hash = (id: string) => (atHome ? `#${id}` : `${home}#${id}`);
const items = [
  ['about', labels.about],
  ['services', labels.services],
  ['portfolio', labels.portfolio],
  ['process', labels.process],
  ['contact', labels.contact],
] as const;
---

<header class="nav">
  <a class="wordmark" href={home}>PBLAND9</a>
  <div class="nav-end">
    <nav class="nav-links" aria-label={navLabel}>
      {
        items.map(([id, label]) => (
          <a href={hash(id)}>{label}</a>
        ))
      }
      <a href={getRelativeLocaleUrl(locale, 'founder')} aria-current={Astro.url.pathname.includes('/founder') ? 'page' : undefined}>
        {labels.founder}
      </a>
    </nav>
    <LangSwitch locale={locale} label={langLabel} />
  </div>
</header>
